# ВНИМАНИЕ: комментарии в .gitignore допустимы только на отдельной строке —
# текст после шаблона становится частью шаблона.

# --- data/ ------------------------------------------------------------------------------
# Коммитим ЗАМОРОЖЕННЫЕ ФОЛДЫ: разбиение — часть решения, на нём измерены все эксперименты,
# и оно должно приезжать вместе с кодом, а не пересчитываться каждым по-своему.
# Данные площадки (train.parquet, sample_submit.csv) и кэш признаков — не коммитим.
data/*
!data/folds.parquet
!data/fold_spec.json

# --- предсказания -----------------------------------------------------------------------
# reference/ коммитится целиком: без него сабмит не собрать без 15 GPU-часов.
# subs/ — рабочий каталог, сюда пишут этапы обучения.
subs/*
!subs/.gitkeep

# результат работы run.sh
submission/

# --- создаётся при обучении -------------------------------------------------------------
oof/
runs/
logs/
experiments.csv

# --- секреты: на всякий случай ----------------------------------------------------------
password.txt
*.pem
*_rsa
*_rsa.pub

# --- рабочий мусор ----------------------------------------------------------------------
__pycache__/
*.py[cod]
.DS_Store
.venv/
venv/
.ipynb_checkpoints/
.claude/
